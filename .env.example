# Copy to .env and fill in. NEVER commit the API key or token.
# IT Glue API key (Account > Settings > API Keys). Sent in the x-api-key header.
ITGLUE_API_KEY=

# Region base URL: .com (default), .eu for EU partners, .au for Australia.
ITGLUE_BASE_URL=https://api.itglue.com

# IT Glue subdomain, used to build clickable document links for internal notes.
ITGLUE_SUBDOMAIN=weller

# Organization used when a tool call omits one (6006071 = Wellers).
ITGLUE_DEFAULT_ORGANIZATION_ID=6006071

ITGLUE_VERIFY_SSL=true
ITGLUE_TIMEOUT=30
# How long a document/org listing is cached for local name search (seconds).
ITGLUE_CACHE_TTL=900

# Bearer key that gates the network MCP endpoints (empty = auth disabled).
# Generate with: openssl rand -hex 32
ITGLUE_MCP_AUTH_TOKEN=

# Optional pointer to a config file written by `config init`.
# ITGLUE_CONFIG_FILE=./itglue.json

# Optional: override the document-link template.
# Placeholders: {subdomain} {org_id} {doc_id}
# ITGLUE_DOC_URL_TEMPLATE=https://{subdomain}.itglue.com/{org_id}/documents/{doc_id}